DATABASE_URL=postgresql://...@...neon.tech/neondb?sslmode=require
JWT_SECRET=minimum-32-karakter-random-string
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NODE_ENV=development
# Optional: initial admin password for scripts/setup.ts (min. 12 chars). Leave empty to generate one.
ADMIN_PASSWORD=
# Optional: Vercel Blob token for drag & drop uploads (added by Vercel when a Blob store is connected).
BLOB_READ_WRITE_TOKEN=
